{
  "name": "migratory-time-docs-addon",
  "private": true,
  "version": "1.0.0",
  "description": "Migratory Time add-on for Feishu Docs.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/writeFeishuConfig.mjs",
    "typecheck": "tsc --noEmit",
    "upload": "npm run build && npm --prefix tools/feishu-upload run upload"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@lark-opdev/block-docs-addon-api": "^0.0.10",
    "react": "~18.2.0",
    "react-dom": "~18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "@types/react": "~18.0.27",
    "@types/react-dom": "~18.0.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
